{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HambaLang",
  "scopeName": "source.hambalang",
  "fileTypes": [
    "hl"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#function-def"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#satire"
    },
    {
      "include": "#state"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.hambalang",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.hambalang",
          "match": "#.*$"
        },
        {
          "name": "comment.block.hambalang",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "match": "\\b(Wacana)\\b(.*)$",
          "captures": {
            "1": {
              "name": "keyword.other.wacana.hambalang"
            },
            "2": {
              "name": "comment.line.wacana.hambalang"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.hambalang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.hambalang",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.hambalang",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.hambalang",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "function-def": {
      "patterns": [
        {
          "match": "\\b(fungsi|prosedur|BagiRata)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.hambalang"
            },
            "2": {
              "name": "entity.name.function.hambalang"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.hambalang",
          "match": "\\b(jika|maka|ataujika|atau|akhir|selama|untuk|dari|sampai|langkah|dalam|kembalikan|hentikan|lanjut|mulai|coba|jikaGagal|akhirCoba|akhirProsedur|selesaiRapat|Bubarkan|Sita|Pengadilan|Proyek|Janji|global|Rapat|selesai)\\b"
        },
        {
          "name": "keyword.operator.logical.hambalang",
          "match": "\\b(dan|DAN|ATAU|bukan|BUKAN)\\b"
        },
        {
          "name": "keyword.other.hambalang",
          "match": "\\b(lapor|print|set|Anggaran|Tagih)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.hambalang",
          "match": "\\b(benar|salah|BENAR|SALAH)\\b"
        },
        {
          "name": "constant.language.null.hambalang",
          "match": "\\b(kosong|KOSONG)\\b"
        }
      ]
    },
    "satire": {
      "patterns": [
        {
          "name": "support.function.satire.hambalang",
          "match": "\\b(Korupsi|Mangkrak|RapatInfinite|Audit)\\b"
        }
      ]
    },
    "state": {
      "patterns": [
        {
          "name": "variable.language.state.hambalang",
          "match": "\\b(anggaran|progress|status_proyek|total_korupsi)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hambalang",
          "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "support.function.builtin.hambalang",
          "match": "\\b(panjang|tipe|angka|teks|bulat|bulatkan|boolean|mutlak|akar|pangkat|minimum|maksimum|jumlah|rataRata|acak|acakPilih|rentang|tambahArray|tambah|hapusArray|hapus|sisipkan|ambilAkhir|urutkan|balik|irisan|indeksDari|berisi|salin|petakan|saring|lipat|gabung|pisah|besar|kecil|rapikan|ganti|mulaiDengan|akhiriDengan|ulangi|rupiah|kode|karakter|kunci|nilai|punya|keJSON|dariJSON|pastikan|masukan|waktu|tanggal|tulisFile|tambahFile|bacaFile|adaFile|hapusFile|bacaJSON|tulisJSON|sambungDB|queryDB|tutupDB|httpGet|httpPost)(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.call.hambalang",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.hambalang",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.hambalang",
          "match": "\\+=|-=|\\*=|/=|%=|="
        },
        {
          "name": "keyword.operator.arithmetic.hambalang",
          "match": "\\*\\*|[+\\-*/%!]"
        }
      ]
    }
  }
}
